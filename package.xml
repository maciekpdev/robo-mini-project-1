<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_ekf_pkg</name>
  <version>0.1.0</version>
  <description>
    Own EKF (unicycle model fusing wheel odometry, IMU and 1 Hz ground truth) and a
    robot_localization comparison for IST Intro to Robotics Mini-Project 1, Task 1a,
    plus tools to evaluate the estimates against the full-rate motion-capture ground truth.
  </description>
  <maintainer email="noahkiw@todo.todo">noahkiw</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlebot_datasets</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
